<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Archive - Antitesi</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Frank+Ruhl+Libre:wght@300;400;700&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="style_archive.css"> 
</head>
<body>

    <header class="archive-header">
        <a href="index.html">
            <img src="logo.svg" alt="Antitesi Logo" class="site-logo">
        </a>
    </header>

    <div class="filter-section" id="filterSection">
        
        <svg id="connectionCanvas" class="connection-svg">
            <path id="curvedPath" d="" stroke="currentColor" stroke-width="1.5" fill="none" />
        </svg>

        <div class="filter-row" id="row-format">
            <button class="filter-box" data-group="format">Essay</button>
            <button class="filter-box" data-group="format">Speaking</button>
            <button class="filter-box" data-group="format">Editing</button>
            <button class="filter-box" data-group="format">Journalism</button>
        </div>

        <div class="filter-row" id="row-topic">
            <button class="filter-box" data-group="topic">Fashion</button>
            <button class="filter-box" data-group="topic">Art</button>
            <button class="filter-box" data-group="topic">Culture</button>
            <button class="filter-box" data-group="topic">Design</button>
            <button class="filter-box" data-group="topic">History</button>
        </div>
        
    </div>

    <div class="archive-sheet" id="archiveSheet">
        </div>

    <script src="articles.js"></script>
    <script src="archive.js"></script>

</body>
</html>